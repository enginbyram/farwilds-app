{
  "_about": "Character rules: every number the Character, Creator and Level Up pages use. Edit by hand; the app reloads. Fields starting with _ are ignored. Formulas live in src/rules/compute.ts.",
  "params": [
    {"key": "ScoreMin", "value": 8, "unit": "score", "status": "Settled", "note": "Starting base of every attribute. 8 in all nine is a commoner."},
    {"key": "CreationPoints", "value": 18, "unit": "points", "status": "Settled", "note": "Free attribute points spent in the creator, on top of race and class points."},
    {"key": "CreationMaxPerAttribute", "value": 4, "unit": "points", "status": "Proposed", "note": "Most creator points one attribute can take (the old Main rank was +4)."},
    {"key": "AttributePointsPerLevel", "value": 0, "unit": "points", "status": "Open", "note": "Attribute points granted by each level up (spent on the Level Up screen). Not decided yet."},
    {"key": "SubdominantAscension", "value": 3, "unit": "ascension", "status": "Settled", "note": "The subdominant affinity can be chosen once this ascension is reached."},
    {"key": "SkillPointsPerAscension", "value": 2, "unit": "points", "status": "Settled", "note": "Skill points granted by every ascension reached."},
    {"key": "ScoreMax", "value": 40, "unit": "score", "status": "Settled", "note": "Highest score from base, race, class and progression. Gear is not counted (no cap after all bonuses)."},
    {"key": "ModBase", "value": 10, "unit": "score", "status": "Settled", "note": "Modifier = INT((score − ModBase) / ModDiv)."},
    {"key": "ModDiv", "value": 2, "unit": "", "status": "Settled", "note": "See ModBase."},
    {"key": "MaxLevel", "value": 45, "unit": "level", "status": "Settled", "note": "Core + Ascendancy I–VIII, 5 levels each (9 bands × 5)."},
    {"key": "BandSize", "value": 5, "unit": "levels", "status": "Settled", "note": "Keystones per band; an ascendancy ring follows each band."},
    {"key": "BaseSpeed", "value": 10, "unit": "m/turn", "status": "Settled", "note": "Default Speed; a race may override it."},
    {"key": "HPMinPerLevel", "value": 1, "unit": "HP", "status": "Settled", "note": "A level never grants less than this."},
    {"key": "APMeleeSTR", "value": 1, "unit": "factor", "status": "Settled", "note": "Melee AP = INT(STR mod × (APMeleeSTR + weapon AP) + DEX mod × (APMeleeDEX + weapon AP)). Weapon AP comes from gear."},
    {"key": "APMeleeDEX", "value": 0.5, "unit": "factor", "status": "Settled", "note": "See APMeleeSTR."},
    {"key": "APRangedDEX", "value": 1, "unit": "factor", "status": "Settled", "note": "Ranged AP = INT(DEX mod × (APRangedDEX + weapon AP)). Weapon AP comes from gear."},
    {"key": "PoolPerStep", "value": 2, "unit": "points", "status": "Settled", "note": "Quick = Hit Die (its maximum, d10 = 10) + CON mod; Purequick = Hit Die + WIS mod. Both gain PoolPerStep every PoolStepLevels levels after the first (1 Nov)."},
    {"key": "PoolStepLevels", "value": 2, "unit": "levels", "status": "Settled", "note": "See PoolPerStep. +2 every 2 levels: level 3 +2, level 5 +4, and so on."},
    {"key": "RageMax", "value": 10, "unit": "Rage", "status": "Settled", "note": "Rage scale: rests at 0, thresholds at 5 and 10; gains past 10 are a surge (Barbarian Pathway, 31 Oct)."},
    {"key": "SanityBase", "value": 10, "unit": "Sanity", "status": "Settled", "note": "Sanity = SanityBase + Endurance + SanityPerLevel × (level − 1). Mental endurance; Bloodmagic wears it down."},
    {"key": "SanityPerLevel", "value": 1, "unit": "Sanity", "status": "Proposed", "note": "Sanity gained per level after the first, as the well grows."},
    {"key": "CarryPerSTR", "value": 8, "unit": "kg", "status": "Settled", "note": "Carry capacity per point of Strength score. Capacity = STR score × this."}
  ],
