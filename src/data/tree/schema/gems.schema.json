{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Farwilds gem texts",
  "description": "Node id \u2192 its text. Works for any node. Keys starting with _ are notes and are ignored.",
  "type": "object",
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
      "^_": {}
    },
    "properties": {
      "description": {
        "type": "string",
        "description": "What the node does. Shown in the node card."
      },
      "flavor": {
        "type": "string",
        "description": "An in-world line, shown in italics under the description."
      },
      "bonuses": {
        "type": "array",
        "description": "Each line is plain text, or {\"effect\": id, \"value\": n, \"when\": \"\u2026\"}.",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "effect"
              ],
              "additionalProperties": false,
              "properties": {
                "effect": {
                  "description": "A key of world.json \u2192 effects, or skill:<Skill name> (e.g. skill:Endurance).",
                  "anyOf": [
                    {
                      "enum": [
                        "str",
                        "dex",
                        "con",
                        "enc",
                        "log",
                        "wis",
                        "pre",
                        "rhe",
                        "aut",
                        "life",
                        "ar",
                        "ap",
                        "ap_melee",
                        "ap_ranged",
                        "sp",
                        "leech",
                        "init",
                        "speed",
                        "quick_pool",
                        "well",
                        "pq_pool",
                        "rage_gain",
                        "rage_max",
                        "sanity",
                        "cold_dmg",
                        "fire_dmg",
                        "acid_dmg",
                        "lightning_dmg",
                        "sonic_dmg",
                        "force_dmg",
                        "necrotic_dmg",
                        "psychic_dmg",
                        "radiant_dmg",
                        "poison_dmg"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "2 \u2192 '+2', -1 \u2192 '-1'. Unit % is added from the effect."
                },
                "when": {
                  "type": "string",
                  "description": "Condition: 'while Raging'. A bonus with 'when' is shown only; without it, it is added to the sheet."
                }
              }
            }
          ]
        }
      }
    }
  }
}
